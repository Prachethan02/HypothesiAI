# ==============================================================================
# HypothesiAI Python AI Service — Environment Variables Template
# ==============================================================================
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Backend Internal Cluster URL
BACKEND_INTERNAL_URL=http://backend:5000

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# Resource Allocation
DEVICE=auto
MAX_WORKERS=2
BATCH_SIZE=32
ENABLE_NEURAL_FALLBACK=true

# Model Storage / Local Cache
MODEL_CACHE_DIR=/app/.cache/models

# Model Identifiers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL_NAME=cross-encoder/nli-distilroberta-base

# LLM Provider Configuration (Stage 16)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
