# ==============================================================================
# HypothesiAI Frontend Application — Environment Variables Template
# ==============================================================================
# Note: Vite injects environment variables prefixed with VITE_ at build time.
# In production, set this to your publicly accessible backend API gateway URL.

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=HypothesiAI
VITE_APP_ENV=production
