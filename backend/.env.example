# ==============================================================================
# HypothesiAI Backend Service — Environment Variables Template
# ==============================================================================
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.hypothesiai.com,http://localhost:5173

# PostgreSQL / Managed Database (RDS / Supabase / Neon)
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/hypothesiai
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20

# Neo4j Graph Database (AuraDB or Self-Hosted)
# For AuraDB use: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=false

# AI Service Internal Cluster URL
AI_SERVICE_URL=http://ai-service:8000

# Storage Driver: "local" (disk) or "s3" (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_BUCKET=hypothesiai-papers
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Authentication
JWT_SECRET=generate_a_random_64_char_hex_secret_in_production
JWT_EXPIRES_IN=7d
