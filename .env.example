# ==============================================================================
# HypothesiAI Environment Configuration Template
# ==============================================================================
# Duplicate this file to .env in the respective service directories or root.
# NEVER commit actual secrets or production keys to version control.

# ------------------------------------------------------------------------------
# Backend Service Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# PostgreSQL / Supabase Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hypothesiai
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hypothesiai_secret

# AI Service Internal Endpoint
AI_SERVICE_URL=http://localhost:8000

# File Storage (S3 / Cloud Storage / Supabase Storage / Local fallback)
STORAGE_DRIVER=local
STORAGE_BUCKET=hypothesiai-papers
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# JWT / Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# AI Service Configuration (Python / FastAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
BACKEND_INTERNAL_URL=http://localhost:5000

# Model Paths / Cache
MODEL_CACHE_DIR=.cache/models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL_NAME=cross-encoder/nli-distilroberta-base

# LLM Provider Configuration (Stage 5)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Application Configuration (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=HypothesiAI
VITE_APP_ENV=development
