# ==============================================================================
# HypothesiAI — Consolidated Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env in root or into specific subdirectories (backend, ai-service, frontend).
# NEVER commit actual secrets, API tokens, passwords, or encryption keys to version control.

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (Node.js / Express API Gateway)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.hypothesiai.com,http://localhost:3000,http://localhost:5173

# PostgreSQL / Managed Database (AWS RDS / Supabase / Neon)
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/hypothesiai
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20

# Neo4j Graph Database (Neo4j AuraDB or Self-Hosted)
# For Neo4j AuraDB use: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=false

# AI Service Internal Cluster URL
AI_SERVICE_URL=http://localhost:8000

# File Storage Provider: "local" (disk) or "s3" (AWS S3, Cloudflare R2, MinIO, GCP)
STORAGE_DRIVER=local
STORAGE_BUCKET=hypothesiai-papers
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# JWT Authentication
JWT_SECRET=generate_a_random_64_char_hex_secret_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 2. AI Engine Service Configuration (Python / FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Backend Internal Cluster URL
BACKEND_INTERNAL_URL=http://localhost:5000

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# Hardware & Resource Allocation
DEVICE=auto
MAX_WORKERS=2
BATCH_SIZE=32
ENABLE_NEURAL_FALLBACK=true

# Model Storage / Local Cache
MODEL_CACHE_DIR=.cache/models

# Model Identifiers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL_NAME=cross-encoder/nli-distilroberta-base

# LLM Provider Configuration (Stage 16)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Frontend Client Configuration (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=HypothesiAI
VITE_APP_ENV=production
